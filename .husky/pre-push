
echo "🔍 Running TSC..."
npm run tsc
tsc_status=$?


echo
echo "🔍 Running ESLint..."
npm run lint
eslint_status=$?

echo
echo "🎨 Running Prettier..."
npm run format
prettier_status=$?

echo
echo "🎨 Running Build..."
npm run build
build_status=$?

if [ $eslint_status -ne 0 ] || [ $prettier_status -ne 0 ]; then
  echo
  echo "❌ Push aborted due to lint or format errors."
  exit 1
fi

echo
echo "✅ All checks passed. Ready to push."